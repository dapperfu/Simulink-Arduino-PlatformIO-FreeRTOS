# Generated by piofrtos.generateTargetFiles. Do not edit by hand.
#
# Template makefile for the Arduino FreeRTOS (PlatformIO) target.
# make_rtw expands tokens and then invokes MATLAB gmake, which calls
# the host-installed PlatformIO CLI.

#------------------------ Macros read by make_rtw ------------------------------
#
# MAKECMD         - Command used to invoke the make utility
# HOST            - PC or UNIX
# BUILD           - Invoke make from the build procedure (yes/no)
# SYS_TARGET_FILE - Name of system target file

MAKECMD         = "|>MATLAB_BIN<|/|>ARCH<|/gmake"
HOST            = PC
BUILD           = yes
SYS_TARGET_FILE = piofrtos.tlc
BUILD_SUCCESS   = ### Created

#---------------------- Tokens expanded by make_rtw ----------------------------

MODEL                   = |>MODEL_NAME<|
MODULES                 = |>MODEL_MODULES<|
MAKEFILE                = |>MAKEFILE_NAME<|
MATLAB_ROOT             = |>MATLAB_ROOT<|
ALT_MATLAB_ROOT         = |>ALT_MATLAB_ROOT<|
START_DIR               = |>START_DIR<|
NUMST                   = |>NUMST<|
NCSTATES                = |>NCSTATES<|
COMPUTER                = |>COMPUTER<|
BUILDARGS               = |>BUILDARGS<|
MULTITASKING            = |>MULTITASKING<|
PRODUCT                 = |>PRODUCT<|
MODELREF_TARGET_TYPE    = |>MODELREF_TARGET_TYPE<|
RELATIVE_PATH_TO_ANCHOR = |>RELATIVE_PATH_TO_ANCHOR<|
DEFINES_CUSTOM          = |>DEFINES_CUSTOM<|
DEFINES_OTHER           = |>DEFINES_OTHER<|
COMPILE_FLAGS_OTHER     = |>COMPILE_FLAGS_OTHER<|
MODEL_HAS_DYNAMICALLY_LOADED_SFCNS = |>MODEL_HAS_DYNAMICALLY_LOADED_SFCNS<|

PIO_PLATFORM            = |>PIO_PLATFORM<|
PIO_BOARD               = |>PIO_BOARD<|
PIO_FRAMEWORK           = |>PIO_FRAMEWORK<|
PIO_MONITOR_SPEED       = |>PIO_MONITOR_SPEED<|
PIO_UPLOAD              = |>PIO_UPLOAD<|
PIO_TASK_STACK_WORDS    = |>PIO_TASK_STACK_WORDS<|

-include pio_cmd.mk
PIO_CMD ?= pio

ifeq ($(MODELREF_TARGET_TYPE),NONE)

ifeq ($(PIO_UPLOAD),1)
ALL_GOAL = firmware upload
else
ifeq ($(PIO_UPLOAD),on)
ALL_GOAL = firmware upload
else
ALL_GOAL = firmware
endif
endif

.PHONY: all firmware upload

all: $(ALL_GOAL)

firmware:
	"$(PIO_CMD)" run --project-dir .
	@echo ### Created PlatformIO firmware for $(MODEL)

upload:
	"$(PIO_CMD)" run --project-dir . -t upload
	@echo ### Uploaded PlatformIO firmware for $(MODEL)

else

.PHONY: all

all:
	@echo ### Skipping PlatformIO for referenced model $(MODEL)

endif
