%% SYSTLC: Arduino FreeRTOS (PlatformIO) TMF: piofrtos.tmf MAKE: make_rtw
%%
%% Generated by piofrtos.generateTargetFiles. Do not edit by hand.
%% Abstract: Embedded Coder target that builds with host-installed PlatformIO
%%           and maps each discrete sample rate to a FreeRTOS task.
%selectfile NULL_FILE

%assign CodeFormat = "Embedded-C"
%assign TargetType = "RT"
%assign Language   = "C"
%assign PreCodeGenExecCompliant = 1
%assign RateBasedStepFcn = 1
%assign SuppressSetEventsForThisBaseRateFcn = 1
%assign SuppressMultiTaskScheduler = 1
%assign AutoBuildProcedure = TLC_FALSE

%include "codegenentry.tlc"

/%
  BEGIN_RTW_OPTIONS

  oIdx = 1;
  rtwoptions(oIdx).prompt         = 'PlatformIO';
  rtwoptions(oIdx).type           = 'Category';
  rtwoptions(oIdx).enable         = 'on';
  rtwoptions(oIdx).default        = 7;
  rtwoptions(oIdx).popupstrings   = '';
  rtwoptions(oIdx).tlcvariable    = '';
  rtwoptions(oIdx).tooltip        = '';
  rtwoptions(oIdx).callback       = '';
  rtwoptions(oIdx).opencallback   = '';
  rtwoptions(oIdx).closecallback  = '';
  rtwoptions(oIdx).makevariable   = '';

  oIdx = oIdx + 1;
  rtwoptions(oIdx).prompt         = 'PlatformIO platform';
  rtwoptions(oIdx).type           = 'Popup';
  rtwoptions(oIdx).enable         = 'on';
  rtwoptions(oIdx).default        = 'atmelavr';
  rtwoptions(oIdx).popupstrings   = 'atmelavr';
  rtwoptions(oIdx).tlcvariable    = 'PioPlatform';
  rtwoptions(oIdx).makevariable   = 'PIO_PLATFORM';
  rtwoptions(oIdx).tooltip        = 'PlatformIO platform for a known-good board. Atmel AVR boards use atmelavr.';
  rtwoptions(oIdx).callback       = '';

  oIdx = oIdx + 1;
  rtwoptions(oIdx).prompt         = 'PlatformIO board';
  rtwoptions(oIdx).type           = 'Popup';
  rtwoptions(oIdx).enable         = 'on';
  rtwoptions(oIdx).default        = 'Arduino Uno';
  rtwoptions(oIdx).popupstrings   = 'Arduino Uno|Arduino Nano';
  rtwoptions(oIdx).tlcvariable    = 'PioBoard';
  rtwoptions(oIdx).makevariable   = 'PIO_BOARD';
  rtwoptions(oIdx).tooltip        = 'Known-good board. Selecting a board sets platform and framework.';
  rtwoptions(oIdx).callback       = 'piofrtos.syncKnownTarget(hDlg, hSrc)';

  oIdx = oIdx + 1;
  rtwoptions(oIdx).prompt         = 'PlatformIO framework';
  rtwoptions(oIdx).type           = 'Popup';
  rtwoptions(oIdx).enable         = 'on';
  rtwoptions(oIdx).default        = 'arduino';
  rtwoptions(oIdx).popupstrings   = 'arduino';
  rtwoptions(oIdx).tlcvariable    = 'PioFramework';
  rtwoptions(oIdx).makevariable   = 'PIO_FRAMEWORK';
  rtwoptions(oIdx).tooltip        = 'PlatformIO framework. Known-good AVR boards use arduino.';
  rtwoptions(oIdx).callback       = '';

  oIdx = oIdx + 1;
  rtwoptions(oIdx).prompt         = 'Extra libraries';
  rtwoptions(oIdx).type           = 'Edit';
  rtwoptions(oIdx).enable         = 'on';
  rtwoptions(oIdx).default        = 'feilipu/FreeRTOS';
  rtwoptions(oIdx).popupstrings   = '';
  rtwoptions(oIdx).tlcvariable    = 'PioExtraLibraries';
  rtwoptions(oIdx).makevariable   = 'PIO_EXTRA_LIBRARIES';
  rtwoptions(oIdx).tooltip        = 'Optional PlatformIO lib_deps entries. Separate libraries with commas or semicolons. AVR boards need a FreeRTOS port such as feilipu/FreeRTOS.';
  rtwoptions(oIdx).callback       = '';

  oIdx = oIdx + 1;
  rtwoptions(oIdx).prompt         = 'Serial monitor speed';
  rtwoptions(oIdx).type           = 'Edit';
  rtwoptions(oIdx).enable         = 'on';
  rtwoptions(oIdx).default        = '115200';
  rtwoptions(oIdx).popupstrings   = '';
  rtwoptions(oIdx).tlcvariable    = 'PioMonitorSpeed';
  rtwoptions(oIdx).makevariable   = 'PIO_MONITOR_SPEED';
  rtwoptions(oIdx).tooltip        = 'Baud rate passed to PlatformIO monitor_speed and Serial.begin.';
  rtwoptions(oIdx).callback       = '';

  oIdx = oIdx + 1;
  rtwoptions(oIdx).prompt         = 'Upload after build';
  rtwoptions(oIdx).type           = 'Checkbox';
  rtwoptions(oIdx).enable         = 'on';
  rtwoptions(oIdx).default        = 'off';
  rtwoptions(oIdx).popupstrings   = '';
  rtwoptions(oIdx).tlcvariable    = 'PioUpload';
  rtwoptions(oIdx).makevariable   = 'PIO_UPLOAD';
  rtwoptions(oIdx).tooltip        = 'If selected, the generated makefile runs pio run -t upload after a successful build.';
  rtwoptions(oIdx).callback       = '';

  oIdx = oIdx + 1;
  rtwoptions(oIdx).prompt         = 'FreeRTOS task stack (words)';
  rtwoptions(oIdx).type           = 'Edit';
  rtwoptions(oIdx).enable         = 'on';
  rtwoptions(oIdx).default        = '192';
  rtwoptions(oIdx).popupstrings   = '';
  rtwoptions(oIdx).tlcvariable    = 'PioTaskStackWords';
  rtwoptions(oIdx).makevariable   = 'PIO_TASK_STACK_WORDS';
  rtwoptions(oIdx).tooltip        = 'Stack depth passed to xTaskCreate for each sample-rate task. On AVR this is words.';
  rtwoptions(oIdx).callback       = '';

  rtwgensettings.BuildDirSuffix = '_piofrtos_rtw';
  rtwgensettings.Version        = '1';
  rtwgensettings.DerivedFrom    = 'ert.tlc';
  rtwgensettings.SelectCallback = 'piofrtos.selectCallback(hDlg, hSrc)';

  END_RTW_OPTIONS
%/
