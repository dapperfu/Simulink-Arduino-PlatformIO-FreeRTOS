%% arduinopio_analog_output.tlc
%% Inline pinMode / analogWrite for the Arduino PIO Embedded Coder target.
%implements "arduinopio_analog_output" "C"

%function BlockTypeSetup(block, system) void
  %<LibAddToCommonIncludes("arduinopio_arduino.h")>
%endfunction

%function Start(block, system) Output
  /* %<Type> Block: %<Name> */
  {
    pinMode((uint8_T)%<block.ParamSettings.Pin>, OUTPUT);
    analogWrite((uint8_T)%<block.ParamSettings.Pin>, 0);
  }
%endfunction

%function Outputs(block, system) Output
  /* %<Type> Block: %<Name> */
  {
    real_T u = %<LibBlockInputSignal(0, "", "", 0)>;
    int duty;
    if (u < 0.0) {
      duty = 0;
    } else if (u > 255.0) {
      duty = 255;
    } else {
      duty = (int)(u + 0.5);
    }
    analogWrite((uint8_T)%<block.ParamSettings.Pin>, duty);
  }
%endfunction
