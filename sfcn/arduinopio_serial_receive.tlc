%% arduinopio_serial_receive.tlc
%% Inline UART receive for the Arduino PIO Embedded Coder target.
%implements "arduinopio_serial_receive" "C"

%function BlockTypeSetup(block, system) void
  %<LibAddToCommonIncludes("arduinopio_uart.h")>
%endfunction

%function Start(block, system) Output
  /* %<Type> Block: %<Name> */
  {
    arduinopioUartSetup((uint8_T)%<SFcnParamSettings.Port>, (uint32_T)%<SFcnParamSettings.BaudRate>);
  }
%endfunction

%function Outputs(block, system) Output
  /* %<Type> Block: %<Name> */
  {
    uint8_T *y = (uint8_T *)%<LibBlockOutputSignalAddr(0, "", "", 0)>;
    uint8_T length = (uint8_T)%<SFcnParamSettings.DataLength>;
    uint8_T n;
    uint8_T i;
    for (i = 0U; i < length; i++) {
      y[i] = 0U;
    }
    n = arduinopioUartRead((uint8_T)%<SFcnParamSettings.Port>, y, length);
    %<LibBlockOutputSignal(1, "", "", 0)> = (boolean_T)(n > 0U);
  }
%endfunction
