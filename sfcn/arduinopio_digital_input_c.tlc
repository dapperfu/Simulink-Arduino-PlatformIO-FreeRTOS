%% arduinopio_digital_input_c.tlc
%% Inline pinMode / digitalRead for the Level-2 C Digital Input S-function.
%implements "arduinopio_digital_input_c" "C"

%function BlockTypeSetup(block, system) void
  %<LibAddToCommonIncludes("arduinopio_arduino.h")>
%endfunction

%function Start(block, system) Output
  /* %<Type> Block: %<Name> */
  {
    %if SFcnParamSettings.PinPull == 2
    pinMode((uint8_T)%<SFcnParamSettings.Pin>, INPUT_PULLDOWN);
    %elseif SFcnParamSettings.PinPull == 1
    pinMode((uint8_T)%<SFcnParamSettings.Pin>, INPUT_PULLUP);
    %else
    pinMode((uint8_T)%<SFcnParamSettings.Pin>, INPUT);
    %endif
  }
%endfunction

%function Outputs(block, system) Output
  /* %<Type> Block: %<Name> */
  {
    int y;
    y = digitalRead((uint8_T)%<SFcnParamSettings.Pin>);
    %<LibBlockOutputSignal(0, "", "", 0)> = (boolean_T)(y != 0);
  }
%endfunction
