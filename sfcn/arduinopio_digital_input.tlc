%% arduinopio_digital_input.tlc
%% Inline pinMode / digitalRead for the Arduino PIO Embedded Coder target.
%implements "arduinopio_digital_input" "C"

%function BlockTypeSetup(block, system) void
  %<LibAddToCommonIncludes("arduinopio_arduino.h")>
%endfunction

%function Start(block, system) Output
  /* %<Type> Block: %<Name> */
  {
    uint8_T pin = (uint8_T)%<block.ParamSettings.Pin>;
    int pinPull = (int)%<block.ParamSettings.PinPull>;
    if (pinPull == 2) {
      pinMode(pin, INPUT_PULLDOWN);
    } else if (pinPull == 1) {
      pinMode(pin, INPUT_PULLUP);
    } else {
      pinMode(pin, INPUT);
    }
  }
%endfunction

%function Outputs(block, system) Output
  /* %<Type> Block: %<Name> */
  {
    int y;
    y = digitalRead((uint8_T)%<block.ParamSettings.Pin>);
    %<LibBlockOutputSignal(0, "", "", 0)> = (boolean_T)(y != 0);
  }
%endfunction
