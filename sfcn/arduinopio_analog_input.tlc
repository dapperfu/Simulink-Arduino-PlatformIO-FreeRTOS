%% arduinopio_analog_input.tlc
%% Inline analog input for the Arduino PIO Embedded Coder target.
%implements "arduinopio_analog_input" "C"

%function BlockTypeSetup(block, system) void
  %<LibAddToCommonIncludes("arduinopio_adc.h")>
%endfunction

%function Start(block, system) Output
  /* %<Type> Block: %<Name> */
  {
    arduinopioAnalogSetup((uint8_T)%<SFcnParamSettings.Pin>);
  }
%endfunction

%function Outputs(block, system) Output
  /* %<Type> Block: %<Name> */
  {
    %<LibBlockOutputSignal(0, "", "", 0)> = arduinopioAnalogRead((uint8_T)%<SFcnParamSettings.Pin>);
  }
%endfunction
