%% arduinopio_analog_input.tlc
%% Inline analogRead for the Arduino PIO Embedded Coder target.
%implements "arduinopio_analog_input" "C"

%function BlockTypeSetup(block, system) void
  %<LibAddToCommonIncludes("arduinopio_arduino.h")>
%endfunction

%function Outputs(block, system) Output
  /* %<Type> Block: %<Name> */
  {
    uint16_T y;
    y = (uint16_T)analogRead((uint8_T)%<block.ParamSettings.Pin>);
    %<LibBlockOutputSignal(0, "", "", 0)> = y;
  }
%endfunction
